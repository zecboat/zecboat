# Build output — regenerated by cargo and npm, gigabytes if committed
target/
**/target/
node_modules/
**/node_modules/
dist/
build/
.output/
.nuxt/
.svelte-kit/
**/.svelte-kit/

# Logs
*.log
nohup.out

# Key material — must never be committed.
# Git history is permanent: a secret committed once survives deletion, and on a
# public host it survives in forks and caches after a force-push.
*.gpg
*.pem
*.key
*.p12
*.pfx
*seed*
*identity*
*.age
wallet.db
wallet.db-*
wallet.db.*
market.enc

# ANY database. A file named test.db in this tree held a real wallet account with
# viewing keys and 25 derived addresses — the name said "test", the contents did not.
# Match the category, not the filename.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env
.env.*

# Addresses and local notes — not secret, but specific to whoever ran this
UA*.txt
*_ua.txt

# Backups and scratch — these carried stale paths from a machine that no longer exists
*.bak
*.bak-*
*.old
*.orig
*.rej
*.patch

# Proving parameters — 50 MB, fetched from download.z.cash, never vendored
*.params
.zcash-params/

# Editor and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
